<?xml version="1.0" encoding="utf-8"?>
<!--
    LMS Custom Repository descriptor for SpotOn.

    USERS: Add the raw GitHub URL of this file to:
      LMS Settings → Plugins → Additional Repositories
      URL: https://raw.githubusercontent.com/stiefenm/spoton/main/repo.xml

    MAINTAINERS: When publishing a new version, update sha (sha1sum of zip)
    and url (GitHub release asset URL).
-->
<extensions>
    <details>
        <title lang="EN">SpotOn Repository</title>
        <title lang="DE">SpotOn-Repository</title>
    </details>
    <plugins>
        <plugin
            name="SpotOn"
            version="4.1.0"
            target="unix|mac|windows"
            minTarget="8.0"
            maxTarget="*"
            sha="2698750a4e4025ba3f2ded13cdfa58d41d4e14e1"
            url="https://github.com/stiefenm/spoton/releases/download/v4.1.0/SpotOn-v4.1.0.zip"
            category="musicservices"
            creator="Marek Stiefenhofer"
            email="sti@posteo.de"
        >
            <title lang="EN">SpotOn</title>
            <title lang="DE">SpotOn</title>
            <desc lang="EN">Spotify plugin for Lyrion Music Server. Coming from 3.5.x: no Spotify Developer App any more - after the update, pair your account once in SpotOn Settings (see UPGRADING.md on GitHub).</desc>
            <desc lang="DE">Spotify-Plugin fuer Lyrion Music Server. Von 3.5.x kommend: keine Spotify Developer App mehr - nach dem Update das Konto einmal in den SpotOn-Einstellungen koppeln (siehe UPGRADING.md auf GitHub).</desc>
            <link>https://github.com/stiefenm/spoton</link>
        </plugin>
    </plugins>
</extensions>
